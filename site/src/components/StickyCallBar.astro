---
/**
 * The highest-leverage element on the site (#10).
 *
 * It makes the primary call-to-action reachable at any scroll depth, which is
 * what makes "the form is secondary" true in practice rather than in theory.
 * Present on every page.
 *
 * Pure static HTML anchors — a `tel:` and a `wa.me` link work at 100% uptime,
 * with no dependency on the laptop being awake.
 */
import { BUSINESS, WHATSAPP_DEFAULT } from "../data/business.ts";
---

<div
  class="fixed inset-x-0 bottom-0 z-50 grid grid-cols-2 gap-px border-t border-black/10 bg-black/10 md:hidden"
>
  <a
    href={`tel:${BUSINESS.phoneE164}`}
    class="flex items-center justify-center gap-2 bg-brand-600 px-4 py-4 text-base font-semibold text-white active:bg-brand-700"
  >
    <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"
      ></path>
    </svg>
    Call now
  </a>
  <a
    href={WHATSAPP_DEFAULT}
    class="flex items-center justify-center gap-2 bg-green-600 px-4 py-4 text-base font-semibold text-white active:bg-green-700"
  >
    <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm5.1 14.1c-.2.6-1.2 1.2-1.7 1.2-.5 0-.9.2-3-.7a11.6 11.6 0 0 1-4.8-4.3c-.4-.6-1-1.6-1-3s.8-2.1 1-2.4c.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .6.5l.9 2c.1.2.1.4 0 .6l-.4.6-.3.3c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1a7 7 0 0 0 2 1.3c.3.1.4.1.6-.1l.8-1c.2-.2.4-.2.6-.1l2 1c.2.1.4.2.4.3v.5Z"
      ></path>
    </svg>
    WhatsApp
  </a>
</div>
