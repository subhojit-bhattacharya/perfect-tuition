---
/**
 * The same block ends every page (#10): Call · WhatsApp · link to /contact/.
 *
 * The phone and WhatsApp taps are the primary call-to-action, and they are plain
 * links that work whether or not the enquiry API is reachable. The form is the
 * secondary path, which is why it is a quieter link here rather than a third
 * equal button.
 */
import { BUSINESS, WHATSAPP_DEFAULT } from "../data/business.ts";

interface Props {
  /** Suppressed on /contact/, where the form is already on the page. */
  showFormLink?: boolean;
}
const { showFormLink = true } = Astro.props;
---

<section class="border-t border-slate-200 bg-brand-900">
  <div class="mx-auto max-w-3xl px-6 py-14 text-center">
    <h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">
      Talk to {BUSINESS.ownerFamiliar}
    </h2>
    <p class="mt-3 text-brand-100">
      Calls are answered {BUSINESS.callHours}. The quickest way to get an answer about your
      child's class and subjects is to ring.
    </p>

    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center">
      <a
        href={`tel:${BUSINESS.phoneE164}`}
        class="inline-flex items-center justify-center gap-2 rounded-lg bg-accent-400 px-6 py-3.5 text-base font-semibold text-ink shadow-sm transition hover:bg-accent-500"
      >
        Call {BUSINESS.phoneDisplay}
      </a>
      <a
        href={WHATSAPP_DEFAULT}
        class="inline-flex items-center justify-center gap-2 rounded-lg bg-green-600 px-6 py-3.5 text-base font-semibold text-white shadow-sm transition hover:bg-green-700"
      >
        Message on WhatsApp
      </a>
    </div>

    {
      showFormLink && (
        <p class="mt-6 text-sm text-brand-100">
          Prefer to write?{" "}
          <a href="/contact/" class="font-semibold text-white underline underline-offset-4">
            Send an enquiry instead
          </a>
        </p>
      )
    }
  </div>
</section>
