---
/**
 * The only page with the Enquiry form (#10).
 *
 * One consent surface to version, audit and legally review, instead of five —
 * and replicating the form elsewhere would quietly re-promote a path that was
 * deliberately demoted.
 */
import Base from "../layouts/Base.astro";
import ConversionBlock from "../components/ConversionBlock.astro";
import EnquiryForm from "../components/EnquiryForm.astro";
import { BUSINESS, WHATSAPP_DEFAULT } from "../data/business.ts";
---

<Base
  title="Contact Perfect Tuition — Dum Dum Park, Kolkata"
  description="Call 062911 65454, message on WhatsApp, or send an enquiry. Perfect Tuition, Arnab Apartment, 444 Dum Dum Park Road, Kolkata 700055."
>
  <div class="mx-auto max-w-3xl px-6 py-12">
    <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">Contact us</h1>
    <p class="mt-4 text-lg text-ink-soft">
      Ringing is the fastest way to get an answer. The form below reaches the same place, a little
      slower.
    </p>

    <!-- The primary path, above the form. -->
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a
        href={`tel:${BUSINESS.phoneE164}`}
        class="flex flex-1 items-center justify-center rounded-xl bg-brand-600 px-6 py-4 text-lg font-semibold text-white shadow-sm transition hover:bg-brand-700"
      >
        Call {BUSINESS.phoneDisplay}
      </a>
      <a
        href={WHATSAPP_DEFAULT}
        class="flex flex-1 items-center justify-center rounded-xl bg-green-600 px-6 py-4 text-lg font-semibold text-white shadow-sm transition hover:bg-green-700"
      >
        WhatsApp
      </a>
    </div>
    <p class="mt-3 text-sm text-ink-soft">Calls answered {BUSINESS.callHours}.</p>

    <!-- NAP and hours -->
    <div class="mt-12 grid gap-8 sm:grid-cols-2">
      <div class="rounded-xl bg-slate-50 p-6">
        <h2 class="text-lg font-semibold text-ink">Where we are</h2>
        <address class="mt-3 text-sm not-italic leading-relaxed text-ink-soft">
          {BUSINESS.address.line1}<br />
          {BUSINESS.address.line2}<br />
          {BUSINESS.address.line3}<br />
          {BUSINESS.address.locality}, {BUSINESS.address.region} {BUSINESS.address.postalCode}
        </address>
        <p class="mt-3 text-sm">
          <a href={`tel:${BUSINESS.phoneE164}`} class="font-medium text-brand-600 hover:underline">
            {BUSINESS.phoneDisplay}
          </a>
        </p>
        {/*
          The full Google listing string, once, verbatim. It is the citation a
          parent cross-checks against the profile they found us on. It is not
          used as the Display Name anywhere, because it packs service keywords
          into the name in breach of Google's own naming policy.
        */}
        <p class="mt-4 border-t border-slate-200 pt-3 text-xs text-ink-soft">
          Listed on Google as “{BUSINESS.legalListingName}”.
        </p>
      </div>

      <div class="rounded-xl bg-slate-50 p-6">
        <h2 class="text-lg font-semibold text-ink">Timings</h2>
        <dl class="mt-3 space-y-2 text-sm">
          {
            BUSINESS.batches.map((b) => (
              <div class="flex justify-between gap-4 border-b border-slate-200 pb-2">
                <dt class="text-ink-soft">{b.label}</dt>
                <dd class="font-medium tabular-nums text-ink">{b.time}</dd>
              </div>
            ))
          }
        </dl>
        <p class="mt-3 text-sm text-ink-soft">Batches run {BUSINESS.batchDays}.</p>
        <p class="mt-1 text-sm text-ink-soft">Calls answered {BUSINESS.callHours}.</p>
      </div>
    </div>

    <!--
      A committed OpenStreetMap image wrapped in a plain link, NOT a Google Maps
      iframe. A Maps embed is third-party Google JavaScript that contacts Google
      and can set cookies on load, before any interaction — which contradicts the
      no-tracker rule outright. OpenStreetMap rather than Google's Static Maps
      API because that API's terms restrict storing and caching its imagery, and
      committing a PNG to a public repository is exactly that.
    -->
    <section class="mt-12">
      <h2 class="text-lg font-semibold text-ink">Find us</h2>
      <a
        href={BUSINESS.mapsUrl}
        rel="noopener"
        class="mt-3 block overflow-hidden rounded-xl border border-slate-200"
      >
        <img
          src="/map-dum-dum-park.png"
          width="800"
          height="500"
          loading="lazy"
          alt={`Map showing Perfect Tuition at ${BUSINESS.addressOneLine}`}
          class="w-full"
        />
      </a>
      <p class="mt-2 text-xs text-ink-soft">
        Map data ©
        <a href="https://www.openstreetmap.org/copyright" class="underline" rel="noopener">
          OpenStreetMap contributors</a
        >. Tap the map to open directions.
      </p>
    </section>

    <!-- The form -->
    <section class="mt-14 border-t border-slate-200 pt-12">
      <h2 class="text-2xl font-bold tracking-tight text-ink">Send an enquiry</h2>
      <p class="mt-2 text-ink-soft">
        Tell us your child's class and the subjects you need, and {BUSINESS.ownerFamiliar} will
        ring you back.
      </p>

      <div class="mt-8">
        <EnquiryForm />
      </div>
    </section>
  </div>

  <ConversionBlock showFormLink={false} />
</Base>
