---
/**
 * Homepage — Variant A, "Call first" (#9).
 *
 * Above the fold, on one phone screenful, in this order and nothing else:
 * the Display Name, the boards and classes, the location, the years and rating,
 * then Call and WhatsApp.
 *
 * No hero carousel and no mission statement. A parent who cannot tell within
 * three seconds whether you teach their child's class and board will leave, and
 * "is this near me" is the literal first question in a hyperlocal search — so
 * the location earns its place above the fold.
 */
import Base from "../layouts/Base.astro";
import ConversionBlock from "../components/ConversionBlock.astro";
import { BANDS, BUSINESS, WHATSAPP_DEFAULT } from "../data/business.ts";
---

<Base
  title="Perfect Tuition — ICSE & CBSE coaching in Dum Dum Park, Kolkata"
  description="Small-batch coaching for classes 3–12, ICSE and CBSE, in Dum Dum Park, Kolkata. Teaching since 2012. Call 062911 65454."
>
  <!-- Above the fold -->
  <section class="border-b border-slate-200 bg-gradient-to-b from-brand-50 to-white">
    <div class="mx-auto max-w-3xl px-6 pb-12 pt-12 sm:pt-16">
      <h1 class="text-4xl font-bold tracking-tight text-ink sm:text-5xl">
        {BUSINESS.name}
      </h1>

      <p class="mt-4 text-xl font-medium text-ink sm:text-2xl">
        Coaching for <span class="text-brand-600">ICSE &amp; CBSE, classes 3–12</span>
      </p>

      <p class="mt-2 text-lg text-ink-soft">
        Dum Dum Park, Kolkata
      </p>

      <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-ink-soft">
        <span>Teaching since {BUSINESS.founded}</span>
        <span aria-hidden="true">·</span>
        <a
          href={BUSINESS.googleProfileUrl}
          rel="noopener"
          class="inline-flex items-center gap-1.5 hover:text-brand-600"
        >
          <span class="font-semibold text-ink">{BUSINESS.rating}</span>
          <span aria-hidden="true" class="text-accent-500">★</span>
          <span>average on Google, as of {BUSINESS.ratingAsOf}</span>
        </a>
      </p>

      <!-- The primary action, before anything else on the page. -->
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href={`tel:${BUSINESS.phoneE164}`}
          class="flex flex-1 items-center justify-center gap-2 rounded-xl bg-brand-600 px-6 py-4 text-lg font-semibold text-white shadow-sm transition hover:bg-brand-700"
        >
          Call {BUSINESS.phoneDisplay}
        </a>
        <a
          href={WHATSAPP_DEFAULT}
          class="flex flex-1 items-center justify-center gap-2 rounded-xl bg-green-600 px-6 py-4 text-lg font-semibold text-white shadow-sm transition hover:bg-green-700"
        >
          WhatsApp
        </a>
      </div>

      <p class="mt-3 text-sm text-ink-soft">Calls answered {BUSINESS.callHours}.</p>
    </div>
  </section>

  <!-- Below the fold -->
  <section class="mx-auto max-w-5xl px-6 py-14">
    <h2 class="text-2xl font-bold tracking-tight text-ink">What we teach</h2>
    <p class="mt-2 text-ink-soft">
      A class 9 or 10 student may take either senior group.
    </p>

    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {
        BANDS.map((band) => (
          <div class="flex flex-col rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <span class="self-start rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-brand-700">
              {band.tag}
            </span>
            <h3 class="mt-4 text-lg font-semibold text-ink">{band.label}</h3>
            <p class="mt-1 text-sm font-medium text-ink-soft">{band.boards}</p>
            {band.note && <p class="mt-1 text-sm text-ink-soft">{band.note}</p>}
            <ul class="mt-4 flex flex-wrap gap-1.5">
              {band.subjects.map((s) => (
                <li class="rounded-md bg-slate-100 px-2 py-1 text-xs text-ink-soft">{s}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <p class="mt-8">
      <a
        href="/coaching-centre/"
        class="text-sm font-semibold text-brand-600 hover:underline underline-offset-4"
      >
        See the full subject list and batch timings →
      </a>
    </p>
  </section>

  <!-- Timings, fee band and location -->
  <section class="border-y border-slate-200 bg-slate-50">
    <div class="mx-auto grid max-w-5xl gap-10 px-6 py-14 md:grid-cols-3">
      <div>
        <h2 class="text-lg font-semibold text-ink">Batch timings</h2>
        <dl class="mt-4 space-y-2 text-sm">
          {
            BUSINESS.batches.map((b) => (
              <div class="flex justify-between gap-4 border-b border-slate-200 pb-2">
                <dt class="text-ink-soft">{b.label}</dt>
                <dd class="font-medium tabular-nums text-ink">{b.time}</dd>
              </div>
            ))
          }
        </dl>
        <p class="mt-3 text-sm text-ink-soft">{BUSINESS.batchDays}.</p>
      </div>

      <div>
        <h2 class="text-lg font-semibold text-ink">Fees</h2>
        <p class="mt-4 text-2xl font-bold text-ink">{BUSINESS.fee}</p>
        <p class="mt-2 text-sm text-ink-soft">
          Small batches, so every child gets attention. Ring for the exact figure for your
          child's class and subjects.
        </p>
      </div>

      <div>
        <h2 class="text-lg font-semibold text-ink">Where we are</h2>
        <address class="mt-4 text-sm not-italic leading-relaxed text-ink-soft">
          {BUSINESS.address.line1}<br />
          {BUSINESS.address.line2}<br />
          {BUSINESS.address.line3}<br />
          {BUSINESS.address.locality} {BUSINESS.address.postalCode}
        </address>
        <p class="mt-3">
          <a
            href="/contact/"
            class="text-sm font-semibold text-brand-600 hover:underline underline-offset-4"
          >
            Map and directions →
          </a>
        </p>
      </div>
    </div>
  </section>

  <ConversionBlock />
</Base>
