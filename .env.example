# Perfect Tuition — environment template.
# Copy to `.env` (git-ignored) or let scripts/setup-tunnel.sh populate it.
#
# NOTE: the Cloudflare Tunnel values below are not secrets. The tunnel's actual
# secret is its credentials JSON, which cloudflared writes to ~/.cloudflared/
# and which must never be copied into this repo. The block at the foot of this
# file IS secret.

# --- Cloudflare Tunnel (written by scripts/setup-tunnel.sh) ---
TUNNEL_DOMAIN=perfect-tuition.co.in
TUNNEL_HOSTNAME=api.perfect-tuition.co.in
TUNNEL_NAME=perfect-tuition-api
TUNNEL_ID=
TUNNEL_CREDENTIALS_FILE=
PAGES_HOST=subhojit-bhattacharya.github.io

# Port the Hono API listens on locally.
API_PORT=3000

# Status Cloudflare returns when the laptop origin is unreachable.
# The frontend's WhatsApp fallback is written against this. Measured, not guessed.
ORIGIN_DOWN_STATUS=

# --- Backup and retention (issue #8) ---
# restic repository on the on-premises USB drive. Not a secret; the password is.
# Drive labelling and the two-drive swap are still being decided in #8.
RESTIC_REPOSITORY=

# --- Real secrets, added by later tickets. Never commit actual values. ---
#
# RECOVERY CHAIN (#8): the restic password is the ONLY secret escrowed on paper.
# It decrypts the repository, which contains this .env, which contains the
# SQLCipher key, which opens the database. Two consequences that are easy to get
# wrong and fatal if you do:
#   1. `.env` must be INCLUDED in the backup, not excluded as a secret.
#   2. Write RESTIC_PASSWORD down BEFORE initialising the repository.
#
# SQLCIPHER_KEY=           # issue #8 — encrypts api/data/enquiries.db at rest
# RESTIC_PASSWORD=         # issue #8 — escrowed on paper, two copies
# TELEGRAM_BOT_TOKEN=      # issue #7
# TELEGRAM_CHAT_ID=        # issue #7
# TURNSTILE_SECRET_KEY=    # issue #6
