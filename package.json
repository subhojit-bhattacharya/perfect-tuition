{
  "name": "perfect-tuition",
  "private": true,
  "type": "module",
  "workspaces": [
    "api",
    "site"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace api",
    "dev:api": "npm run dev --workspace api",
    "dev:site": "npm run dev --workspace site",
    "build:site": "npm run build --workspace site",
    "backup": "tsx scripts/backup.ts",
    "rights": "tsx scripts/enquiry-rights.ts",
    "setup": "git config core.hooksPath .githooks && echo 'core.hooksPath set to .githooks'"
  },
  "devDependencies": {
    "tsx": "^4.23.12",
    "typescript": "~5.9.3"
  }
}
